* KICK-OFF - Main Stylesheet */

:root {
  --cream: #faf8f4;
  --beige: #eee8de;
  --brown: #8b7055;
  --dark: #38332e;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: var(--cream);
  color: var(--dark);
}

button {
  cursor: pointer;
  font-family: inherit;
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: auto;
}

.section-title {
  text-align: center;
  letter-spacing: 3px;
  margin-bottom: 25px;
}

.product-card {
  background: var(--white);
  border: 1px solid #eee5da;
  border-radius: 12px;
  padding: 16px;
}

.primary-button {
  background: var(--brown);
  color: var(--white);
  border: none;
  border-radius: 8px;
  padding: 12px 20px;
}

@media (max-width: 600px) {
  .container {
    width: 92%;
  }
}
